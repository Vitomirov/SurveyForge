// SurveyForge — multi-organization SaaS schema
// Same codebase supports single-tenant enterprise deployments via env + isolated DB.
// DB columns use entity-prefixed names (e.g. organization_name) for clarity in raw SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @map("organization_name")
  settings  Json     @default("{}") @map("organization_settings")
  createdAt DateTime @default(now()) @map("organization_created_at")

  users     User[]
  surveys   Survey[]
  responses Response[]
  clients   Client[]
  topics    Topic[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @map("user_email")
  username       String?  @map("user_username")
  passwordHash   String   @map("user_password_hash")
  name           String?  @map("user_name")
  role           String   @default("editor") @map("user_role")
  createdAt      DateTime @default(now()) @map("user_created_at")
  updatedAt      DateTime @updatedAt @map("user_updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@map("users")
}

model Survey {
  id             String   @id
  organizationId String   @map("organization_id")
  tenantId       String?  @map("tenant_id")
  survey         Json     @map("survey_data")
  items          Json     @default("[]") @map("survey_items")
  revision       Int      @default(1) @map("survey_revision")
  createdAt      DateTime @default(now()) @map("survey_created_at")
  updatedAt      DateTime @updatedAt @map("survey_updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responses    Response[]
  dncEntries   DncEntry[]

  @@index([organizationId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("surveys")
}

model Response {
  id             String   @id
  surveyId       String   @map("survey_id")
  organizationId String   @map("organization_id")
  payload        Json     @map("response_payload")
  status         String   @map("response_status")
  timestamp      DateTime @default(now()) @map("response_timestamp")

  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([organizationId])
  @@index([surveyId, status])
  @@map("responses")
}

model Client {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String   @map("client_name")
  createdAt      DateTime @default(now()) @map("client_created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("clients")
}

model Topic {
  id             String   @id
  organizationId String   @map("organization_id")
  name           String   @map("topic_name")
  createdAt      DateTime @default(now()) @map("topic_created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("topics")
}

model DncEntry {
  id       String @id @default(uuid())
  surveyId String @map("survey_id")
  email    String @map("dnc_email")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, email])
  @@index([surveyId])
  @@map("dnc_entries")
}
