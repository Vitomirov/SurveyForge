# PostgreSQL
# Local npm dev (postgres container only): localhost:5433
DATABASE_URL=postgresql://surveyforge:surveyforge@localhost:5433/surveyforge

# API server (3001 is often taken by other dev apps — use 3003 to match Vite proxy)
PORT=3003
NODE_ENV=development

# Auth (Phase B2+)
JWT_SECRET=change-me-in-production

# Client feature flag (Phase B1+)
# VITE_USE_API=true

# Docker full stack (`docker compose up --build`):
# - App UI: http://localhost:8080  (override with WEB_HOST_PORT)
# - Postgres host port: 5433       (override with POSTGRES_HOST_PORT)
# - Set JWT_SECRET in the shell or a `.env` file next to docker-compose.yml
