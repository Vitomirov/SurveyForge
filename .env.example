# PostgreSQL (local docker-compose default)
DATABASE_URL=postgresql://surveyforge:surveyforge@localhost:5433/surveyforge

# API server (3001 is often taken by other dev apps — use 3003 to match Vite proxy)
PORT=3003
NODE_ENV=development

# Auth (Phase B2+)
JWT_SECRET=change-me-in-production

# Client feature flag (Phase B1+)
# VITE_USE_API=true
