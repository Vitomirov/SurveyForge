{
  "name": "survey-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "dev:all": "concurrently -n vite,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "db:generate": "npm run db:generate --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:migrate:dev": "npm run db:migrate:dev --prefix server",
    "build": "vite build",
    "build:analyze": "vite build && node -e \"const fs=require('fs');const d='dist/assets';const files=fs.readdirSync(d).filter(f=>f.endsWith('.js'));console.log('JS chunks:',files.length);files.forEach(f=>console.log(f, (fs.statSync(d+'/'+f).size/1024).toFixed(1)+'KB'))\"",
    "preview": "vite preview",
    "check:registries": "node scripts/check-registries.js",
    "test:phase2": "node --test scripts/phase2.test.mjs",
    "test:phase3": "node --test scripts/phase3.test.mjs",
    "test:phase4": "node --test scripts/phase4.test.mjs",
    "test:track-a": "node --test scripts/phase2.test.mjs scripts/phase3.test.mjs scripts/phase4.test.mjs",
    "test:rbac1": "node --test scripts/phase-r1-auth.test.mjs",
    "test:rbac2": "node --test scripts/phase-r2-ownership.test.mjs",
    "test:rbac3": "node --test scripts/phase-r3-rbac.test.mjs",
    "test:rbac4": "node --test scripts/phase-r4-permissions.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
